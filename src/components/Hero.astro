---
import { Picture } from 'astro:assets';
import heroImg from '../assets/hero.webp';
import { site } from '../data/site';
---

<section id="topo" class="hero">
  <div class="wordmark">
    <p class="wordmark__name">{site.name}</p>
    <p class="wordmark__role">Psicóloga clínica · {site.crp}</p>
  </div>

  <div class="hero__wrap">
    <div class="hero__card">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        width={2560}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="(max-width: 1240px) 100vw, 1176px"
        alt="Camila Américo sentada em um pufe de couro, olhando para a janela, diante de um espelho orgânico em um ambiente claro"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__overlay" aria-hidden="true"></div>

      <div class="hero__body">
        <div class="hero__content">
          <span class="eyebrow eyebrow--light">Escuta antes da técnica</span>
          <h1 class="hero__title">Um espaço de escuta para você se encontrar.</h1>
          <div class="hero__actions">
            <a class="btn btn--solid" href={site.whatsapp}>Conversar no WhatsApp</a>
            <a class="btn btn--ghost" href="#sobre">Conhecer meu trabalho</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-bottom: 96px;
    overflow: hidden;
  }

  .wordmark {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 8px 24px 0;
    text-align: center;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(46px, 9vw, 132px);
    line-height: 1.25;
    letter-spacing: -0.035em;
    color: var(--espresso);
    white-space: nowrap;
  }

  .wordmark__role {
    font-size: 11px;
    letter-spacing: 0.34em;
    font-weight: 500;
    color: var(--outline);
    text-transform: uppercase;
  }

  .hero__wrap {
    position: relative;
    z-index: 1;
    max-width: var(--container-wide);
    margin: -52px auto 0;
    padding-inline: var(--gutter);
  }

  .hero__card {
    position: relative;
    overflow: hidden;
    min-height: min(74vh, 660px);
    display: flex;
    align-items: flex-end;
    box-shadow: 0 30px 70px rgba(64, 21, 4, 0.14);
  }

  .hero__card :global(picture),
  .hero__img,
  .hero__overlay {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    background: linear-gradient(
      90deg,
      rgba(var(--overlay), 0.76) 0%,
      rgba(var(--overlay), 0.55) 45%,
      rgba(var(--overlay), 0.12) 80%,
      rgba(var(--overlay), 0) 100%
    );
  }

  .hero__body {
    position: relative;
    width: 100%;
    padding: 64px 60px 60px;
  }

  .hero__content {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    align-items: flex-start;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 50px;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--surface);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 4px;
    width: 100%;
  }

  .btn {
    padding: 15px 30px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--surface);
  }

  .btn--solid {
    background: var(--primary);
  }

  .btn--solid:hover {
    background: var(--primary-container);
    color: #fff;
  }

  .btn--ghost {
    border: 1px solid rgba(255, 248, 245, 0.5);
    background: rgba(255, 248, 245, 0.1);
  }

  .btn--ghost:hover {
    border-color: var(--peach-light);
    color: var(--peach-light);
    background: rgba(255, 248, 245, 0.2);
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--section-y);
    }

    .wordmark__name {
      white-space: normal;
    }

    .hero__wrap {
      margin-top: 20px;
    }

    .hero__card {
      min-height: 540px;
    }

    .hero__body {
      padding: 40px 24px;
    }

    .hero__title {
      font-size: 32px;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: 28px;
    }

    .btn {
      flex: 1 1 100%;
      text-align: center;
    }
  }
</style>
